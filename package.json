    "fast-xml-parser": "^5.11.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "image-size": "^2.0.4",
    "iron-webcrypto": "^1.2.1",
    "msedge-tts": "^2.1.1",
    "nuxt": "^3.15.4",
    "nuxt-auth-utils": "^0.5.7",
    "opentype.js": "^2.0.0",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },

{
  "name": "my-postiz",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "prisma generate && nuxt prepare",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "worker": "node --env-file=.env worker/index.js",

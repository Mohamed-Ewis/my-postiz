# Database (SQLite now; for Postgres change provider in prisma/schema.prisma and this URL)
DATABASE_URL="file:./dev.db"
# Session cookie password (min 32 chars) used by nuxt-auth-utils
NUXT_SESSION_PASSWORD="change-me-to-a-random-string-at-least-32-chars"
# Optional admin login from env. If empty, first-run setup page creates the user.
NUXT_ADMIN_EMAIL=""
NUXT_ADMIN_PASSWORD=""
# 32-byte key as 64 hex chars for AES-256-GCM token encryption
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_TOKEN_ENCRYPTION_KEY=""
NUXT_PUBLIC_APP_URL="http://localhost:3000"
MEDIA_DIR="./storage/media"
# Later: public base URL (tunnel / R2) so Instagram can fetch media
MEDIA_PUBLIC_BASE_URL=""
# AI captions: gemini | openai
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Worker poll interval (ms)
WORKER_INTERVAL_MS=15000
# Allow the fake "mock" provider (set false once real accounts are connected)
ENABLE_MOCK_PROVIDER=true
# Max upload size in MB (streamed to disk)
MAX_UPLOAD_MB=4096
# AI images
GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"
OPENAI_IMAGE_MODEL="gpt-image-1"
# OPENAI_BASE_URL="https://api.openai.com/v1"

# ---- Social platforms (leave empty until you connect them) ----
# Facebook Pages + Instagram Business (same Meta app)
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_GRAPH_VERSION="v23.0"
# LinkedIn
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_VERSION="202509"
# X (Twitter) ??? console.x.com app, OAuth 2.0 Web App (confidential). Callback: <APP_URL>/api/accounts/x/callback
X_CLIENT_ID=""
X_CLIENT_SECRET=""
# Optional: how long to wait inline for X video processing before handing off to the worker (ms)
# X_INLINE_WAIT_MS=45000
# YouTube (Google Cloud OAuth client, type Web)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
YOUTUBE_DEFAULT_PRIVACY="public"
# TikTok
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_DEFAULT_PRIVACY="SELF_ONLY"

# ---- Video studio ----
# FFmpeg/FFprobe are bundled via npm (ffmpeg-static / ffprobe-static). Override if needed:
FFMPEG_PATH=""
FFPROBE_PATH=""

# News collection for the reel stepper (optional; Google News RSS works without a key)
THENEWSAPI_KEY=""

# Dev only: skip the login screen (server/middleware/dev-auth.js). Never enable on a public server.
AUTH_DISABLED=false

# ---- Voice-over (TTS) ----
# One fixed voice: Gemini "ar-eg-podcaster-1" (Egyptian news host), uses GEMINI_API_KEY above. It can't be changed per request.
# Per-category delivery style is built in. If every Gemini model fails (quota/error) the reel falls back to the Edge voice
# (ar-EG-ShakirNeural, no key needed), then to music-only, so a render never fails because of the voice.
# Gemini TTS model chain, tried in order (comma separated; ":generate" = generateContent API). Every model must support the
# ar-eg-podcaster-1 voice. Empty = built-in chain (gemini-3.8-flash-tts, gemini-3.8-flash-lite-tts, gemini-3.8-flash-tts:generate).
GEMINI_TTS_MODELS=""
# Min ms between Gemini TTS requests per model (free tier is about 3 requests/min and 10/day per model). Empty = 21000.
GEMINI_TTS_MIN_INTERVAL_MS=""
